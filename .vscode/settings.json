{
    // 사용자 설정이 intelliSenseEngine=disabled 이므로 이 작업 영역에서만 활성화
    "C_Cpp.intelliSenseEngine": "default",
    // STM32 clangd 확장은 이 작업 영역(e3dp)에서 끄고 cpptools만 사용
    "stm32cube-ide-clangd.enable": false,
    "stm32cube-ide-clangd.detectExtensionConflicts": false,
    "C_Cpp.default.configurationProvider": "ms-vscode.cpptools",
    "C_Cpp.default.browse.limitSymbolsToIncludedHeaders": false,
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.autocomplete": "default",
    "C_Cpp.workspaceParsingPriority": "medium",
    "C_Cpp.files.exclude": {
        "**/_backup/**": true,
        "**/os_old/**": true,
        "**/os_new/**": true,
        "**/.git/**": true,
        "**/tests/**": true
    },
    "files.eol": "\n",
    "files.associations": {
        "*.h": "c"
    },
    "search.exclude": {
        "**/_backup": true,
        "**/os_old": true,
        "**/os_new": true
    },
    "files.exclude": {
        "**/.mypy_cache": true
    }
}
